# AdultingOS Frontend Environment Variables
# Copy this file to .env.local and customize as needed

# Django API Base URL (default: http://127.0.0.1:8000)
# This is where the main REST API endpoints live (auth, tasks, tags, profile)
REACT_APP_API_URL=http://127.0.0.1:8000

# FastAPI Assistant Base URL (default: http://127.0.0.1:8001)
# This is where the AI assistant/chat endpoint lives
REACT_APP_ASSISTANT_URL=http://127.0.0.1:8001
